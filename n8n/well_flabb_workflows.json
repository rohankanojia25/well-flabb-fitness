    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH trials AS (\n  SELECT COALESCE(string_agg(CONCAT('• ', name, ' (', phone, ') - ', batch, ' - Goal: ', COALESCE(goal, 'General')), E'\\n'), '• No trials booked today') as trial_list,\n  COUNT(*) as trial_count\n  FROM public.leads \n  WHERE status = 'trial_booked' AND (trial_date = CURRENT_DATE OR (trial_date IS NULL AND DATE(created_at AT TIME ZONE 'Asia/Kolkata') = CURRENT_DATE))\n),\nexpiring AS (\n  SELECT COALESCE(string_agg(CONCAT('• ', name, ' (', phone, ') - ', plan, ' - Expires ', end_date), E'\\n'), '• No members expiring this week') as exp_list,\n  COUNT(*) as exp_count\n  FROM public.members \n  WHERE end_date >= CURRENT_DATE AND end_date <= CURRENT_DATE + INTERVAL '7 days'\n),\nnew_leads AS (\n  SELECT COUNT(*) as new_lead_count FROM public.leads WHERE status = 'new'\n)\nSELECT \n  trials.trial_list,\n  trials.trial_count,\n  expiring.exp_list,\n  expiring.exp_count,\n  new_leads.new_lead_count,\n  TO_CHAR(CURRENT_DATE, 'DD-Mon-YYYY') as today_date\nFROM trials, expiring, new_leads;"
      },
